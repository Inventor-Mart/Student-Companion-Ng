             data.schoolName is string && data.schoolName.size() <= 150 &&
             (!('schoolCode' in data) || data.schoolCode == null || (data.schoolCode is string && data.schoolCode.size() <= 40)) &&
             (!('emailHash' in data) || data.emailHash == null || (data.emailHash is string && data.emailHash.size() <= 80)) &&
             data.active is bool &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidSchoolRegistry(data) {
      return data.keys().hasAll(['schoolCode', 'adminId', 'schoolName', 'schoolType', 'verificationStatus', 'active', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'schoolCode', 'adminId', 'schoolName', 'schoolType', 'state', 'lga',
               'verificationStatus', 'hasActiveDirectSubscription', 'directSubscriptionExpiresAt',
               'active', 'createdAt', 'updatedAt'
             ]) &&
             data.schoolCode is string && data.schoolCode.size() >= 4 && data.schoolCode.size() <= 40 && data.schoolCode.matches('^[A-Z0-9_\\-]+$') &&
             data.adminId is string && isValidId(data.adminId) &&
             data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 150 &&
             data.schoolType is string && data.schoolType.size() >= 1 && data.schoolType.size() <= 100 &&
             (!('state' in data) || data.state == null || (data.state is string && data.state.size() <= 60)) &&
             (!('lga' in data) || data.lga == null || (data.lga is string && data.lga.size() <= 80)) &&
             data.verificationStatus in ['verified', 'pending_verification'] &&
             (!('hasActiveDirectSubscription' in data) || data.hasActiveDirectSubscription is bool) &&
             (!('directSubscriptionExpiresAt' in data) || data.directSubscriptionExpiresAt == null || (data.directSubscriptionExpiresAt is string && data.directSubscriptionExpiresAt.size() <= 50)) &&
             data.active is bool &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidSchoolEnrollment(data) {
      return data.keys().hasAll(['id', 'schoolCode', 'studentId', 'studentName', 'classLevel', 'stream', 'xp', 'rank', 'streakDays', 'isSubscribed', 'subscriptionTier', 'joinedAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'schoolCode', 'studentId', 'studentName', 'classLevel', 'stream',
               'xp', 'rank', 'streakDays', 'isSubscribed', 'subscriptionTier', 'subscribedUntil',
               'uniformVerified', 'completedNotesCount', 'verifiedMinutes', 'joinedAt', 'updatedAt'
             ]) &&
             data.id is string && isValidId(data.id) &&
             data.schoolCode is string && data.schoolCode.size() >= 4 && data.schoolCode.size() <= 40 && data.schoolCode.matches('^[A-Z0-9_\\-]+$') &&
             data.studentId is string && isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.classLevel in ['JSS 1', 'JSS 2', 'JSS 3', 'SS 1', 'SS 2', 'SS 3', 'University Aspirant'] &&
             data.stream in ['Junior', 'Science', 'Non-Science'] &&
             data.xp is number && data.xp >= 0 &&
             data.rank is string && data.rank.size() >= 1 && data.rank.size() <= 50 &&
             data.streakDays is number && data.streakDays >= 0 &&
             data.isSubscribed is bool &&
             data.subscriptionTier in ['free', 'basic', 'standard', 'elite'] &&
             (!('subscribedUntil' in data) || data.subscribedUntil == null || (data.subscribedUntil is string && data.subscribedUntil.size() <= 50)) &&
             (!('uniformVerified' in data) || data.uniformVerified is bool) &&
             (!('completedNotesCount' in data) || (data.completedNotesCount is number && data.completedNotesCount >= 0)) &&
             (!('verifiedMinutes' in data) || (data.verifiedMinutes is number && data.verifiedMinutes >= 0)) &&
             data.joinedAt is string && data.joinedAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidAICoachUsage(data) {
      return data.keys().hasAll(['id', 'studentId', 'dateWat', 'planType', 'count', 'dailyLimit', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'studentId', 'dateWat', 'planType', 'count', 'dailyLimit', 'lastPromptAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.dateWat is string && data.dateWat.size() == 10 && data.dateWat.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.planType in ['addon', 'elite', 'admin_bypass'] &&
             data.count is number && data.count >= 0 && data.count <= 9999 &&
             data.dailyLimit is number && data.dailyLimit >= 1 && data.dailyLimit <= 9999 &&
             (!('lastPromptAt' in data) || data.lastPromptAt == null || (data.lastPromptAt is string && data.lastPromptAt.size() <= 50)) &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // --- COLLECTION RULES ---

    // 1. Students Collection (Paid subscriptions, addOns, XP & rank locked to Admin/Server)
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (isOwner(studentId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(studentId) && incoming().id == studentId && isValidStudentProfile(incoming()) && (
        isAdmin() ||
        (
          isOwner(studentId) &&
          (!('isSubscribed' in incoming()) || incoming().isSubscribed == false) &&
          (!('subscriptionPlan' in incoming()) || incoming().subscriptionPlan == 'free') &&
          (!('subscriptionTier' in incoming()) || incoming().subscriptionTier == 'free') &&
          incoming().xp == 0 &&
          incoming().rank == 'Fresher' &&
          (!('addOns' in incoming()) || incoming().addOns.size() == 0)
        )
      );
      allow update: if isValidId(studentId) && isValidStudentProfile(incoming()) && incoming().id == existing().id && (
        isAdmin() ||
        (
          isOwner(studentId) &&
          incoming().classLevel == existing().classLevel &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'school', 'stream', 'lastStudyDate',
            'uniformVerified', 'uniformPhotoUrl', 'downloadedSubjectIds',
            'completedQuizIds', 'completedReadNoteIds', 'verifiedReadingLogs',
            'dailyExploration', 'studentLinkCode', 'schoolCode', 'referredByCode'
          ])
        )
      );
      allow delete: if isAdmin() || isOwner(studentId);

      // Subcollection: Exam Results
      match /examResults/{resultId} {
        allow get: if isValidId(studentId) && isValidId(resultId) && (isOwner(studentId) || isAdmin());
        allow list: if isOwner(studentId) || isAdmin();
        allow create: if isOwner(studentId) && isValidId(studentId) && isValidId(resultId) && incoming().id == resultId && incoming().studentId == studentId && isValidExamResult(incoming()) && exists(/databases/$(database)/documents/students/$(studentId));
        allow update, delete: if isAdmin();
      }
    }

    // 2. User Accounts Collection (PII & RBAC isolated; non-admins cannot elevate role or enforcement flags)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && incoming().id == userId && isValidUserAccount(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().role != 'admin' &&
          (!('isSuperAdmin' in incoming()) || incoming().isSuperAdmin == false) &&
          (!('isDeveloper' in incoming()) || incoming().isDeveloper == false) &&
          (!('accountStatus' in incoming()) || incoming().accountStatus == 'active') &&
          (!('walletFrozen' in incoming()) || incoming().walletFrozen == false)
        )
      );
      allow update: if isValidId(userId) && isValidUserAccount(incoming()) && incoming().id == existing().id && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().role == existing().role &&
          incoming().email == existing().email &&
          (!('isSuperAdmin' in incoming()) || incoming().isSuperAdmin == existing().isSuperAdmin) &&
          (!('isDeveloper' in incoming()) || incoming().isDeveloper == existing().isDeveloper) &&
          (!('accountStatus' in incoming()) || incoming().accountStatus == existing().accountStatus) &&
          (!('walletFrozen' in incoming()) || incoming().walletFrozen == existing().walletFrozen) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'avatarUrl', 'parentData', 'tutorData', 'legalConsent'])
        )
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // 3. Parent Wallets Collection (balanceNaira locked against client writes; PIN-only owner update)
    match /wallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && incoming().userId == userId && isValidParentWallet(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().balanceNaira == 0)
      );
      allow update: if isValidId(userId) && isValidParentWallet(incoming()) && incoming().userId == existing().userId && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().balanceNaira == existing().balanceNaira &&
          incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // 3b. Authoritative Parent Escrow Wallets & Transactions (Admin/Server write only; owner read)
    match /parentWallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(userId) && incoming().id == userId && isValidParentWalletLedger(incoming());
      allow update: if isAdmin() && isValidId(userId) && incoming().id == existing().id && isValidParentWalletLedger(incoming());
      allow delete: if isAdmin();

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() && isValidId(userId) && isValidId(txId) && incoming().id == txId && isValidParentWalletTransaction(incoming());
        allow update, delete: if isAdmin();
      }
    }

    // 4. Tutor Bookings Collection (Restricted strictly to booking participants & Super Admins)
    match /tutorBookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isAdmin() ||
        (isVerified() && (existing().studentId == request.auth.uid || existing().tutorId == request.auth.uid))
      );
      allow list: if isAdmin() || (
        isVerified() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.tutorId == request.auth.uid
        )
      );
      allow create: if isVerified() && isValidId(bookingId) && incoming().id == bookingId && incoming().studentId == request.auth.uid && isValidTutorBooking(incoming());
      allow update: if isValidId(bookingId) && isValidTutorBooking(incoming()) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().tutorId == existing().tutorId &&
        incoming().amountNaira == existing().amountNaira && (
          isAdmin() ||
          (
            isVerified() && existing().status != 'completed' && existing().status != 'cancelled' && (
              (existing().studentId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isParentApproved', 'parentApprovalDate', 'escrowStatus'])) ||
              (existing().tutorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isTutorApproved', 'tutorApprovalDate', 'tutorRejectionReason', 'escrowStatus'])) ||
              (existing().studentId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'escrowStatus'])) ||
              (existing().studentId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
            )
          )
        );
      allow delete: if isAdmin();
    }

    // 5. Tutoring Chats Collection (Participant-isolated via chatId participant check)
    match /chats/{chatId}/messages/{messageId} {
      allow get: if isValidId(chatId) && isValidId(messageId) && (isAdmin() || isChatParticipant(chatId));
      allow list: if isValidId(chatId) && (isAdmin() || isChatParticipant(chatId));
      allow create: if isValidId(chatId) && isValidId(messageId) && (isAdmin() || isChatParticipant(chatId)) && incoming().id == messageId && incoming().senderId == request.auth.uid && isValidChatMessage(incoming());
      allow update, delete: if isAdmin();
    }

    // 6. Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerified() && (request.auth.uid == adminId || isAdmin());
      allow create, update: if isValidId(adminId) && isValidAdmin(incoming()) && (
        isAdmin() || (
          isVerified() &&
          request.auth.uid == adminId &&
          request.auth.token.email in ['martorefe@gmail.com', 'wowrealities@gmail.com', 'martinnosaomorefe@gmail.com']
        )
      );
      allow list, delete: if isAdmin();
    }

    // 7. Growth Partners, Referrals & Financial Ledgers (Strictly owner/Admin isolated — zero public reads/writes)
    match /growthPartners/{partnerId} {
      allow get: if isValidId(partnerId) && (isAdmin() || isOwner(partnerId));
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(partnerId) && incoming().id == partnerId && isValidGrowthPartner(incoming());
      allow update: if isAdmin() && isValidId(partnerId) && incoming().id == existing().id && isValidGrowthPartner(incoming());
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && (isAdmin() || (isVerified() && existing().partnerId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.partnerId == request.auth.uid);
      allow create: if isAdmin() && isValidId(referralId) && incoming().id == referralId && isValidReferral(incoming());
      allow update: if isAdmin() && isValidId(referralId) && incoming().id == existing().id && isValidReferral(incoming());
      allow delete: if isAdmin();
    }

    match /partnerWallets/{partnerId} {
      allow get: if isValidId(partnerId) && (isAdmin() || isOwner(partnerId));
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(partnerId) && incoming().partnerId == partnerId && isValidPartnerWallet(incoming());
      allow update: if isAdmin() && isValidId(partnerId) && incoming().partnerId == existing().partnerId && isValidPartnerWallet(incoming());
      allow delete: if isAdmin();
    }

    match /revenueShareTransactions/{transactionId} {
      allow get: if isValidId(transactionId) && (isAdmin() || (isVerified() && existing().partnerId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.partnerId == request.auth.uid);
      allow create: if isAdmin() && isValidId(transactionId) && incoming().id == transactionId && isValidRevenueShareTx(incoming());
      allow update, delete: if isAdmin();
    }

    match /subscriptionPayments/{paymentId} {
      allow get: if isValidId(paymentId) && (isAdmin() || (isVerified() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() && isValidId(paymentId) && incoming().id == paymentId && isValidSubscriptionPayment(incoming());
      allow update, delete: if isAdmin();
    }

    match /processed_paystack_refs/{refId} {
      allow get: if isValidId(refId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(refId) && isValidProcessedPaystackRef(incoming());
      allow update, delete: if false;
    }

    match /aspirantReferralRewards/{rewardId} {
      allow get: if isValidId(rewardId) && (isAdmin() || (isVerified() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() && isValidId(rewardId) && incoming().id == rewardId && isValidAspirantReferralReward(incoming());
      allow update: if isAdmin() && isValidId(rewardId) && incoming().id == existing().id && isValidAspirantReferralReward(incoming());
      allow delete: if isAdmin();
    }

    match /school_subscriptions/{subId} {
      allow get: if isValidId(subId) && (isAdmin() || (isVerified() && existing().adminId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.adminId == request.auth.uid);
      allow create: if isAdmin() && isValidId(subId) && incoming().id == subId && isValidSchoolSubscription(incoming());
      allow update, delete: if isAdmin();
    }

    // 8. Community Forum Collections (Signed-in reads; author/reaction-isolated updates)
    match /forumChannels/{channelId} {
      allow get: if isValidId(channelId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidId(channelId) && incoming().id == channelId && isValidForumChannel(incoming());
      allow update: if isAdmin() && isValidId(channelId) && incoming().id == existing().id && isValidForumChannel(incoming());
      allow delete: if isAdmin();
    }

    match /forumMessages/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidId(messageId) && incoming().id == messageId && incoming().senderId == request.auth.uid && isValidForumMessage(incoming());
      allow update: if isVerified() && isValidId(messageId) && isValidForumMessage(incoming()) && (
        isAdmin() ||
        (
          incoming().id == existing().id &&
          incoming().senderId == existing().senderId &&
          incoming().channelId == existing().channelId &&
          (
            (isOwner(existing().senderId) && incoming().diff(existing()).affectedKeys().hasOnly(['text'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /forumReports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isVerified() && isValidId(reportId) && incoming().id == reportId && incoming().reporterUserId == request.auth.uid && incoming().status == 'pending' && isValidForumReport(incoming());
      allow update, delete: if isAdmin();
    }

    // 9. Connection Test Collection (Read-only single-doc probe)
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // 10. Curriculum & Examination Collections (Writes strictly locked to Super Admin)
    match /pastQuestions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(questionId) && incoming().id == questionId && isValidPastQuestion(incoming());
      allow update: if isAdmin() && isValidId(questionId) && incoming().id == existing().id && isValidPastQuestion(incoming());
      allow delete: if isAdmin();
    }

    match /pastQuestionPapers/{paperId} {
      allow get: if isValidId(paperId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(paperId) && incoming().id == paperId && isValidPastQuestionPaper(incoming());
      allow update: if isAdmin() && isValidId(paperId) && incoming().id == existing().id && isValidPastQuestionPaper(incoming());
      allow delete: if isAdmin();
    }

    match /termly_drills/{drillId} {
      allow get: if isValidId(drillId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(drillId) && incoming().id == drillId && isValidDrillDocument(incoming());
      allow update: if isAdmin() && isValidId(drillId) && incoming().id == existing().id && isValidDrillDocument(incoming());
      allow delete: if isAdmin();
    }

    match /certificate_drills/{drillId} {
      allow get: if isValidId(drillId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(drillId) && incoming().id == drillId && isValidDrillDocument(incoming());
      allow update: if isAdmin() && isValidId(drillId) && incoming().id == existing().id && isValidDrillDocument(incoming());
      allow delete: if isAdmin();
    }

    match /admin_lesson_notes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(noteId) && incoming().id == noteId && isValidAdminLessonNote(incoming());
      allow update: if isAdmin() && isValidId(noteId) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && isValidAdminLessonNote(incoming());
      allow delete: if isAdmin() && isValidId(noteId);
    }

    match /school_materials/{materialId} {
      allow get: if isValidId(materialId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(materialId) && incoming().id == materialId && isValidSchoolMaterial(incoming()) && (
        isAdmin() ||
        (
          isVerified() &&
          exists(/databases/$(database)/documents/schoolRegistry/$(incoming().schoolCode)) &&
          get(/databases/$(database)/documents/schoolRegistry/$(incoming().schoolCode)).data.adminId == request.auth.uid
        )
      );
      allow update: if isValidId(materialId) && incoming().id == existing().id && incoming().schoolCode == existing().schoolCode && isValidSchoolMaterial(incoming()) && (
        isAdmin() ||
        (
          isVerified() &&
          exists(/databases/$(database)/documents/schoolRegistry/$(existing().schoolCode)) &&
          get(/databases/$(database)/documents/schoolRegistry/$(existing().schoolCode)).data.adminId == request.auth.uid
        )
      );
      allow delete: if isValidId(materialId) && (
        isAdmin() ||
        (
          isVerified() &&
          exists(/databases/$(database)/documents/schoolRegistry/$(existing().schoolCode)) &&
          get(/databases/$(database)/documents/schoolRegistry/$(existing().schoolCode)).data.adminId == request.auth.uid
        )
      );
    }

    // 11. OTA Broadcasts, Announcements, Competitions & App Releases
    match /otaBroadcasts/{broadcastId} {
      allow get: if isValidId(broadcastId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /otaAnnouncements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /otaCompetitions/{competitionId} {
      allow get: if isValidId(competitionId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /otaAppReleases/{releaseId} {
      allow get: if isValidId(releaseId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(releaseId) && incoming().id == releaseId && isValidOtaAppRelease(incoming());
      allow update: if isAdmin() && isValidId(releaseId) && incoming().id == existing().id && isValidOtaAppRelease(incoming());
      allow delete: if isAdmin() && isValidId(releaseId);
    }

    match /otaNotifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(notificationId) && incoming().id == notificationId && isValidOtaNotificationBroadcast(incoming());
      allow update: if isAdmin() && isValidId(notificationId) && incoming().id == existing().id && isValidOtaNotificationBroadcast(incoming());
      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // 12. Security Telemetry & Enforcement Collections (Zero public PII/log exposure)
    match /security_incidents/{incidentId} {
      allow get: if isValidId(incidentId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(incidentId) && incoming().id == incidentId && isValidSecurityIncident(incoming());
      allow update: if isAdmin() && isValidId(incidentId) && incoming().id == existing().id && isValidSecurityIncident(incoming());
      allow delete: if isAdmin();
    }

    match /security_reports/{reportId} {
      allow get: if isValidId(reportId) && (isAdmin() || (isVerified() && existing().reporterUserId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.reporterUserId == request.auth.uid);
      allow create: if isVerified() && isValidId(reportId) && incoming().id == reportId && incoming().reporterUserId == request.auth.uid && incoming().status == 'pending' && isValidSecurityReport(incoming());
      allow update: if isAdmin() && isValidId(reportId) && incoming().id == existing().id && isValidSecurityReport(incoming());
      allow delete: if isAdmin();
    }

    match /security_blocks/{blockId} {
      allow get: if isValidId(blockId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(blockId) && incoming().id == blockId && isValidSecurityBlock(incoming());
      allow update: if isAdmin() && isValidId(blockId) && incoming().id == existing().id && isValidSecurityBlock(incoming());
      allow delete: if isAdmin();
    }

    match /security_policies/{policyId} {
      allow get: if isValidId(policyId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(policyId) && isValidSecurityAutomationPolicy(incoming());
      allow update: if isAdmin() && isValidId(policyId) && isValidSecurityAutomationPolicy(incoming());
      allow delete: if isAdmin();
    }

    // 13. Student Link Code, School Registry & Enrollments (PII/roster list locked to owners & Super Admins)
    match /studentLinkRegistry/{code} {
      allow get: if isValidId(code) && (isAdmin() || (isVerified() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() && isValidId(code) && incoming().code == code && isValidStudentLinkRegistry(incoming());
      allow update: if isAdmin() && isValidId(code) && incoming().code == existing().code && incoming().studentId == existing().studentId && isValidStudentLinkRegistry(incoming());
      allow delete: if isAdmin();
    }

    match /schoolRegistry/{schoolCode} {
      allow get: if isValidId(schoolCode) && isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(schoolCode) && incoming().schoolCode == schoolCode && isValidSchoolRegistry(incoming());
      allow update: if isAdmin() && isValidId(schoolCode) && incoming().schoolCode == existing().schoolCode && isValidSchoolRegistry(incoming());
      allow delete: if isAdmin();
    }

    match /schoolEnrollments/{enrollmentId} {
      allow get: if isValidId(enrollmentId) && (isAdmin() || (isVerified() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() && isValidId(enrollmentId) && incoming().id == enrollmentId && isValidSchoolEnrollment(incoming());
      allow update: if isAdmin() && isValidId(enrollmentId) && incoming().id == existing().id && incoming().schoolCode == existing().schoolCode && incoming().studentId == existing().studentId && isValidSchoolEnrollment(incoming());
      allow delete: if isAdmin();
    }

    // 14. SC AI Study Coach Daily Quota Ledger (Server-enforced; owner read only)
    match /aiCoachUsage/{usageId} {
      allow get: if isValidId(usageId) && (isAdmin() || (isVerified() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() && isValidId(usageId) && incoming().id == usageId && isValidAICoachUsage(incoming());
      allow update: if isAdmin() && isValidId(usageId) && isValidAICoachUsage(incoming());
      allow delete: if isAdmin();
    }
  }
}
