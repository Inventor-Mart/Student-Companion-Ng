rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Master Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email in ['martorefe@gmail.com', 'wowrealities@gmail.com', 'martinnosaomorefe@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isChatParticipant(chatId) {
      return isVerified() && (
        chatId.matches('^chat_' + request.auth.uid + '_[a-zA-Z0-9_-]+$') ||
        chatId.matches('^chat_[a-zA-Z0-9_-]+_' + request.auth.uid + '$')
      );
    }

    function isValidAvatarUrl(val) {
      return val == null ||
             (val is string &&
              val.size() <= 50000 &&
              (val.size() == 0 ||
               (val.size() >= 8 && val[0:8] == 'https://') ||
               (val.size() >= 7 && val[0:7] == 'http://') ||
               (val.size() >= 11 && val[0:11] == 'data:image/')));
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidStudentProfile(data) {
      return data.keys().hasAll(['id', 'name', 'school', 'classLevel', 'stream', 'xp', 'rank', 'streakDays']) &&
             data.keys().hasOnly([
               'id', 'name', 'school', 'classLevel', 'stream', 'xp', 'rank', 'streakDays',
               'lastStudyDate', 'uniformVerified', 'uniformPhotoUrl', 'downloadedSubjectIds',
               'completedQuizIds', 'completedReadNoteIds', 'verifiedReadingLogs',
               'schoolCode', 'isSubscribed', 'subscriptionPlan', 'subscriptionTier',
               'subscribedUntil', 'termExpiresAt', 'referredByCode', 'referredPartnerId',
               'referredPartnerName', 'lastSubscribedAt', 'lastPaymentReference',
               'aspirantRewardStatus', 'aspirantFirstPaidAt', 'referralAttributedAt',
               'studentLinkCode', 'dailyExploration', 'addOns'
             ]) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.school is string && data.school.size() <= 150 &&
             data.classLevel in ['JSS 1', 'JSS 2', 'JSS 3', 'SS 1', 'SS 2', 'SS 3', 'University Aspirant'] &&
             data.stream in ['Junior', 'Science', 'Non-Science'] &&
             data.xp is number && data.xp >= 0 &&
             data.rank in ['Fresher', 'Scholar', 'Prefect', 'Senior Boy', 'Senior Girl', 'Senior Prefect'] &&
             data.streakDays is number && data.streakDays >= 0 &&
             (!('lastStudyDate' in data) || (data.lastStudyDate is string && data.lastStudyDate.size() <= 50)) &&
             (!('uniformVerified' in data) || data.uniformVerified is bool) &&
             (!('uniformPhotoUrl' in data) || isValidAvatarUrl(data.uniformPhotoUrl)) &&
             (!('downloadedSubjectIds' in data) || (data.downloadedSubjectIds is list && data.downloadedSubjectIds.size() <= 50)) &&
             (!('completedQuizIds' in data) || (data.completedQuizIds is list && data.completedQuizIds.size() <= 100)) &&
             (!('completedReadNoteIds' in data) || (data.completedReadNoteIds is list && data.completedReadNoteIds.size() <= 200 && (data.completedReadNoteIds.size() == 0 || data.completedReadNoteIds[0] is string))) &&
             (!('verifiedReadingLogs' in data) || (data.verifiedReadingLogs is list && data.verifiedReadingLogs.size() <= 200 && (data.verifiedReadingLogs.size() == 0 || data.verifiedReadingLogs[0] is map))) &&
             (!('schoolCode' in data) || data.schoolCode == null || (data.schoolCode is string && data.schoolCode.size() <= 40)) &&
             (!('isSubscribed' in data) || data.isSubscribed is bool) &&
             (!('subscriptionPlan' in data) || data.subscriptionPlan in ['free', 'basic', 'standard', 'elite']) &&
             (!('subscriptionTier' in data) || data.subscriptionTier in ['free', 'basic', 'standard', 'elite']) &&
             (!('subscribedUntil' in data) || data.subscribedUntil == null || (data.subscribedUntil is string && data.subscribedUntil.size() <= 50)) &&
             (!('termExpiresAt' in data) || data.termExpiresAt == null || (data.termExpiresAt is string && data.termExpiresAt.size() <= 50)) &&
             (!('referredByCode' in data) || data.referredByCode == null || (data.referredByCode is string && data.referredByCode.size() <= 30)) &&
             (!('referredPartnerId' in data) || data.referredPartnerId == null || (data.referredPartnerId is string && data.referredPartnerId.size() <= 128)) &&
             (!('referredPartnerName' in data) || data.referredPartnerName == null || (data.referredPartnerName is string && data.referredPartnerName.size() <= 120)) &&
             (!('lastSubscribedAt' in data) || data.lastSubscribedAt == null || (data.lastSubscribedAt is string && data.lastSubscribedAt.size() <= 50)) &&
             (!('lastPaymentReference' in data) || data.lastPaymentReference == null || (data.lastPaymentReference is string && data.lastPaymentReference.size() <= 128)) &&
             (!('aspirantRewardStatus' in data) || data.aspirantRewardStatus in ['not_eligible', 'eligible', 'claimed_cash_500', 'claimed_data_2gb']) &&
             (!('aspirantFirstPaidAt' in data) || data.aspirantFirstPaidAt == null || (data.aspirantFirstPaidAt is string && data.aspirantFirstPaidAt.size() <= 50)) &&
             (!('referralAttributedAt' in data) || data.referralAttributedAt == null || (data.referralAttributedAt is string && data.referralAttributedAt.size() <= 50)) &&
             (!('studentLinkCode' in data) || data.studentLinkCode == null || (data.studentLinkCode is string && data.studentLinkCode.size() <= 40)) &&
             (!('dailyExploration' in data) || data.dailyExploration is map) &&
             (!('addOns' in data) || data.addOns is map);
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'role', 'fullName', 'email', 'emailVerified', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'role', 'fullName', 'email', 'avatarUrl', 'emailVerified', 'verifiedAt', 'createdAt',
               'studentData', 'parentData', 'tutorData', 'adminData', 'growthPartnerData',
               'isSuperAdmin', 'isDeveloper', 'accountStatus', 'lockedUntil', 'lockReason',
               'suspensionReason', 'suspendedAt', 'deletedAt', 'deletedBy', 'deletionReason',
               'walletFrozen', 'walletFrozenReason', 'legalConsent'
             ]) &&
             data.id is string && isValidId(data.id) &&
             data.role in ['student', 'parent', 'tutor', 'admin', 'growth_partner', 'school_admin'] &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
             data.email is string && data.email.size() <= 150 &&
             (!('avatarUrl' in data) || isValidAvatarUrl(data.avatarUrl)) &&
             data.emailVerified is bool &&
             (!('verifiedAt' in data) || data.verifiedAt == null || (data.verifiedAt is string && data.verifiedAt.size() <= 50)) &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('studentData' in data) || data.studentData is map) &&
             (!('parentData' in data) || data.parentData is map) &&
             (!('tutorData' in data) || data.tutorData is map) &&
             (!('adminData' in data) || data.adminData is map) &&
             (!('growthPartnerData' in data) || data.growthPartnerData is map) &&
             (!('isSuperAdmin' in data) || data.isSuperAdmin is bool) &&
             (!('isDeveloper' in data) || data.isDeveloper is bool) &&
             (!('accountStatus' in data) || data.accountStatus in ['active', 'locked', 'suspended', 'deleted']) &&
             (!('lockedUntil' in data) || data.lockedUntil == null || (data.lockedUntil is string && data.lockedUntil.size() <= 50)) &&
             (!('lockReason' in data) || data.lockReason == null || (data.lockReason is string && data.lockReason.size() <= 300)) &&
             (!('suspensionReason' in data) || data.suspensionReason == null || (data.suspensionReason is string && data.suspensionReason.size() <= 300)) &&
             (!('suspendedAt' in data) || data.suspendedAt == null || (data.suspendedAt is string && data.suspendedAt.size() <= 50)) &&
             (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 50)) &&
             (!('deletedBy' in data) || data.deletedBy == null || (data.deletedBy is string && data.deletedBy.size() <= 150)) &&
             (!('deletionReason' in data) || data.deletionReason == null || (data.deletionReason is string && data.deletionReason.size() <= 300)) &&
             (!('walletFrozen' in data) || data.walletFrozen is bool) &&
             (!('walletFrozenReason' in data) || data.walletFrozenReason == null || (data.walletFrozenReason is string && data.walletFrozenReason.size() <= 300)) &&
             (!('legalConsent' in data) || data.legalConsent == null || data.legalConsent is map);
    }

    function isValidExamResult(data) {
      return data.keys().hasAll(['id', 'studentId', 'examId', 'examTitle', 'subject', 'score', 'totalQuestions', 'percentage', 'xpAwarded']) &&
             data.keys().hasOnly(['id', 'studentId', 'examId', 'examTitle', 'subject', 'score', 'totalQuestions', 'percentage', 'timeSpentSeconds', 'xpAwarded', 'date']) &&
             data.id is string && isValidId(data.id) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.examId is string && data.examId.size() <= 128 &&
             data.examTitle is string && data.examTitle.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.score is number && data.score >= 0 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
             data.xpAwarded is number && data.xpAwarded >= 0 &&
             (!('timeSpentSeconds' in data) || data.timeSpentSeconds is number) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50));
    }

    function isValidParentWallet(data) {
      return data.keys().hasAll(['userId', 'balanceNaira']) &&
             data.keys().hasOnly(['userId', 'balanceNaira', 'pin', 'updatedAt']) &&
             data.userId is string && isValidId(data.userId) &&
             data.balanceNaira is number && data.balanceNaira >= 0 &&
             (!('pin' in data) || (data.pin is string && data.pin.size() <= 10)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidParentWalletLedger(data) {
      return data.keys().hasAll(['id', 'parentId']) &&
             data.keys().hasOnly(['id', 'parentId', 'balance', 'balanceNaira', 'totalFunded', 'lastFundedAt', 'lastPaymentReference', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.parentId is string && isValidId(data.parentId) &&
             (!('balance' in data) || (data.balance is number && data.balance >= 0)) &&
             (!('balanceNaira' in data) || (data.balanceNaira is number && data.balanceNaira >= 0)) &&
             (!('totalFunded' in data) || (data.totalFunded is number && data.totalFunded >= 0)) &&
             (!('lastFundedAt' in data) || (data.lastFundedAt is string && data.lastFundedAt.size() <= 50)) &&
             (!('lastPaymentReference' in data) || (data.lastPaymentReference is string && data.lastPaymentReference.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidParentWalletTransaction(data) {
      return data.keys().hasAll(['id', 'parentId', 'type', 'amount', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'parentId', 'type', 'amount', 'channel', 'reference', 'status', 'purpose', 'wardName', 'description', 'board', 'subject', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.parentId is string && isValidId(data.parentId) &&
             data.type in ['fund', 'credit', 'debit'] &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['success', 'successful', 'pending', 'failed'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('channel' in data) || (data.channel is string && data.channel.size() <= 50)) &&
             (!('reference' in data) || (data.reference is string && data.reference.size() <= 128)) &&
             (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 100)) &&
             (!('wardName' in data) || (data.wardName is string && data.wardName.size() <= 120)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             (!('board' in data) || (data.board is string && data.board.size() <= 50)) &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 100));
    }

    function isValidTutorBooking(data) {
      return data.keys().hasAll(['id', 'tutorId', 'tutorName', 'studentId', 'studentName', 'subject', 'topic', 'bookingType', 'date', 'timeSlot', 'status', 'amountNaira', 'isParentApproved']) &&
             data.keys().hasOnly([
               'id', 'tutorId', 'tutorName', 'tutorPhoto', 'studentId', 'studentName',
               'subject', 'topic', 'bookingType', 'date', 'timeSlot',
               'scheduledStartIso', 'scheduledEndIso', 'status', 'amountNaira',
               'commissionRatePercent', 'platformFeeNaira', 'tutorNetNaira',
               'isParentApproved', 'parentApprovalDate',
               'isTutorApproved', 'tutorApprovalDate', 'tutorRejectionReason',
               'paymentReference', 'paymentGateway', 'escrowStatus', 'createdAt'
             ]) &&
             data.id is string && isValidId(data.id) &&
             data.tutorId is string && data.tutorId.size() <= 128 &&
             data.tutorName is string && data.tutorName.size() <= 100 &&
             (!('tutorPhoto' in data) || (data.tutorPhoto is string && data.tutorPhoto.size() <= 500)) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() <= 100 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.topic is string && data.topic.size() <= 200 &&
             data.bookingType in ['online', 'physical'] &&
             data.date is string && data.date.size() <= 100 &&
             data.timeSlot is string && data.timeSlot.size() <= 100 &&
             (!('scheduledStartIso' in data) || (data.scheduledStartIso is string && data.scheduledStartIso.size() <= 100)) &&
             (!('scheduledEndIso' in data) || (data.scheduledEndIso is string && data.scheduledEndIso.size() <= 100)) &&
             data.status in ['pending_payment', 'pending_parent', 'pending_tutor', 'confirmed', 'completed', 'cancelled'] &&
             data.amountNaira is number && data.amountNaira >= 0 &&
             (!('commissionRatePercent' in data) || (data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 100)) &&
             (!('platformFeeNaira' in data) || (data.platformFeeNaira is number && data.platformFeeNaira >= 0)) &&
             (!('tutorNetNaira' in data) || (data.tutorNetNaira is number && data.tutorNetNaira >= 0)) &&
             data.isParentApproved is bool &&
             (!('parentApprovalDate' in data) || (data.parentApprovalDate is string && data.parentApprovalDate.size() <= 100)) &&
             (!('isTutorApproved' in data) || data.isTutorApproved is bool) &&
             (!('tutorApprovalDate' in data) || (data.tutorApprovalDate is string && data.tutorApprovalDate.size() <= 100)) &&
             (!('tutorRejectionReason' in data) || (data.tutorRejectionReason is string && data.tutorRejectionReason.size() <= 300)) &&
             (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 128)) &&
             (!('paymentGateway' in data) || data.paymentGateway in ['paystack_live', 'parent_escrow_wallet', 'tutor_credit']) &&
             (!('escrowStatus' in data) || data.escrowStatus in ['unpaid', 'held_in_escrow', 'released', 'refunded']) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'sender', 'text', 'timestamp']) &&
             data.keys().hasOnly(['id', 'senderId', 'sender', 'text', 'timestamp']) &&
             data.id is string && isValidId(data.id) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.sender in ['student', 'tutor'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.timestamp is string && data.timestamp.size() <= 100;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.keys().hasOnly(['email', 'role', 'updatedAt']) &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['superadmin', 'curriculum_moderator'] &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidGrowthPartner(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'referralCode', 'commissionRatePercent', 'totalEarningsNaira', 'totalPaidOutNaira', 'activeReferralsCount', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'name', 'email', 'phone', 'referralCode', 'commissionRatePercent', 'totalEarningsNaira', 'totalPaidOutNaira', 'activeReferralsCount', 'bankName', 'accountNumber', 'accountName', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.referralCode is string && data.referralCode.size() <= 30 &&
             data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 100 &&
             data.totalEarningsNaira is number && data.totalEarningsNaira >= 0 &&
             data.totalPaidOutNaira is number && data.totalPaidOutNaira >= 0 &&
             data.activeReferralsCount is number && data.activeReferralsCount >= 0 &&
             data.status in ['active', 'suspended', 'pending_approval'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 100)) &&
             (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() <= 30)) &&
             (!('accountName' in data) || (data.accountName is string && data.accountName.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['id', 'partnerId', 'referredUserId', 'referralCodeUsed', 'status', 'totalVolumePaidNaira', 'totalCommissionEarnedNaira', 'createdAt']) &&
             data.keys().hasOnly(['id', 'partnerId', 'referredUserId', 'referredUserName', 'referralCodeUsed', 'status', 'totalVolumePaidNaira', 'totalCommissionEarnedNaira', 'lastPaymentDate', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.partnerId is string && isValidId(data.partnerId) &&
             data.referredUserId is string && isValidId(data.referredUserId) &&
             data.referralCodeUsed is string && data.referralCodeUsed.size() <= 30 &&
             data.status in ['active', 'churned'] &&
             data.totalVolumePaidNaira is number && data.totalVolumePaidNaira >= 0 &&
             data.totalCommissionEarnedNaira is number && data.totalCommissionEarnedNaira >= 0 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('referredUserName' in data) || (data.referredUserName is string && data.referredUserName.size() <= 100)) &&
             (!('lastPaymentDate' in data) || (data.lastPaymentDate is string && data.lastPaymentDate.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidPartnerWallet(data) {
      return data.keys().hasAll(['partnerId', 'balanceNaira', 'lifetimeEarnedNaira', 'totalWithdrawnNaira']) &&
             data.keys().hasOnly(['partnerId', 'balanceNaira', 'lifetimeEarnedNaira', 'totalWithdrawnNaira', 'updatedAt']) &&
             data.partnerId is string && isValidId(data.partnerId) &&
             data.balanceNaira is number && data.balanceNaira >= 0 &&
             data.lifetimeEarnedNaira is number && data.lifetimeEarnedNaira >= 0 &&
             data.totalWithdrawnNaira is number && data.totalWithdrawnNaira >= 0 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidRevenueShareTx(data) {
      return data.keys().hasAll(['id', 'partnerId', 'studentId', 'studentName', 'paymentId', 'subscriptionPlan', 'paymentAmountNaira', 'commissionRatePercent', 'commissionAmountNaira', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'partnerId', 'studentId', 'studentName', 'paymentId', 'subscriptionPlan', 'paymentAmountNaira', 'commissionRatePercent', 'commissionAmountNaira', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.partnerId is string && isValidId(data.partnerId) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() <= 100 &&
             data.paymentId is string && data.paymentId.size() <= 128 &&
             data.subscriptionPlan is string && data.subscriptionPlan.size() <= 100 &&
             data.paymentAmountNaira is number && data.paymentAmountNaira >= 0 &&
             data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 100 &&
             data.commissionAmountNaira is number && data.commissionAmountNaira >= 0 &&
             data.status in ['credited', 'reversed'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidSubscriptionPayment(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'plan', 'amountNaira', 'paymentGateway', 'status', 'partnerCommissionCredited', 'createdAt']) &&
             data.keys().hasOnly(['id', 'studentId', 'studentName', 'plan', 'amountNaira', 'paymentGateway', 'status', 'partnerId', 'partnerCommissionCredited', 'commissionAmountNaira', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() <= 100 &&
             data.plan is string && data.plan.size() <= 100 &&
             data.amountNaira is number && data.amountNaira >= 0 &&
             data.paymentGateway in ['Paystack', 'Flutterwave', 'Direct Escrow'] &&
             data.status in ['successful', 'pending', 'failed'] &&
             data.partnerCommissionCredited is bool &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('partnerId' in data) || (data.partnerId == null || (data.partnerId is string && isValidId(data.partnerId)))) &&
             (!('commissionAmountNaira' in data) || (data.commissionAmountNaira is number && data.commissionAmountNaira >= 0)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidForumChannel(data) {
      return data.keys().hasAll(['id', 'title', 'audience', 'category']) &&
             data.keys().hasOnly(['id', 'title', 'description', 'audience', 'category', 'iconName', 'messageCount', 'lastActivityAt']) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             data.audience in ['student', 'parent'] &&
             data.category in ['academics', 'competitions', 'general', 'parenting', 'exams'] &&
             (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 50)) &&
             (!('messageCount' in data) || (data.messageCount is number && data.messageCount >= 0)) &&
             (!('lastActivityAt' in data) || (data.lastActivityAt is string && data.lastActivityAt.size() <= 50));
    }

    function isValidForumMessage(data) {
      return data.keys().hasAll(['id', 'channelId', 'senderId', 'senderName', 'senderRole', 'text']) &&
             data.keys().hasOnly(['id', 'channelId', 'senderId', 'senderName', 'senderRole', 'senderClassLevel', 'senderRank', 'senderSchool', 'text', 'reactions', 'isReported', 'replyToId', 'replyToText', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.channelId is string && isValidId(data.channelId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.senderRole in ['student', 'parent', 'tutor', 'admin'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
