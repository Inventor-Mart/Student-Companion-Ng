rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Master Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'martorefe@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'wowrealities@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidStudentProfile(data) {
      return data.keys().hasAll(['id', 'name', 'school', 'classLevel', 'stream', 'xp', 'rank', 'streakDays']) &&
             data.keys().hasOnly(['id', 'name', 'school', 'classLevel', 'stream', 'xp', 'rank', 'streakDays', 'lastStudyDate', 'uniformVerified', 'uniformPhotoUrl', 'downloadedSubjectIds', 'completedQuizIds', 'completedReadNoteIds', 'verifiedReadingLogs']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.school is string && data.school.size() <= 150 &&
             data.classLevel in ['JSS 1', 'JSS 2', 'JSS 3', 'SS 1', 'SS 2', 'SS 3', 'University Aspirant'] &&
             data.stream in ['Junior', 'Science', 'Non-Science'] &&
             data.xp is number && data.xp >= 0 &&
             data.rank in ['Fresher', 'Scholar', 'Prefect', 'Senior Boy', 'Senior Girl', 'Senior Prefect'] &&
             data.streakDays is number && data.streakDays >= 0 &&
             (!('lastStudyDate' in data) || (data.lastStudyDate is string && data.lastStudyDate.size() <= 50)) &&
             (!('uniformVerified' in data) || data.uniformVerified is bool) &&
             (!('uniformPhotoUrl' in data) || data.uniformPhotoUrl == null || (data.uniformPhotoUrl is string && data.uniformPhotoUrl.size() <= 500)) &&
             (!('downloadedSubjectIds' in data) || (data.downloadedSubjectIds is list && data.downloadedSubjectIds.size() <= 50)) &&
             (!('completedQuizIds' in data) || (data.completedQuizIds is list && data.completedQuizIds.size() <= 100)) &&
             (!('completedReadNoteIds' in data) || (data.completedReadNoteIds is list && data.completedReadNoteIds.size() <= 200 && (data.completedReadNoteIds.size() == 0 || data.completedReadNoteIds[0] is string))) &&
             (!('verifiedReadingLogs' in data) || (data.verifiedReadingLogs is list && data.verifiedReadingLogs.size() <= 200 && (data.verifiedReadingLogs.size() == 0 || data.verifiedReadingLogs[0] is map)));
    }

    function isValidExamResult(data) {
      return data.keys().hasAll(['id', 'studentId', 'examId', 'examTitle', 'subject', 'score', 'totalQuestions', 'percentage', 'xpAwarded']) &&
             data.keys().hasOnly(['id', 'studentId', 'examId', 'examTitle', 'subject', 'score', 'totalQuestions', 'percentage', 'timeSpentSeconds', 'xpAwarded', 'date']) &&
             data.id is string && isValidId(data.id) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.examId is string && data.examId.size() <= 128 &&
             data.examTitle is string && data.examTitle.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.score is number && data.score >= 0 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
             data.xpAwarded is number && data.xpAwarded >= 0 &&
             (!('timeSpentSeconds' in data) || data.timeSpentSeconds is number) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50));
    }

    function isValidParentWallet(data) {
      return data.keys().hasAll(['userId', 'balanceNaira']) &&
             data.keys().hasOnly(['userId', 'balanceNaira', 'pin', 'updatedAt']) &&
             data.userId is string && isValidId(data.userId) &&
             data.balanceNaira is number && data.balanceNaira >= 0 &&
             (!('pin' in data) || (data.pin is string && data.pin.size() <= 10)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidTutorBooking(data) {
      return data.keys().hasAll(['id', 'tutorId', 'tutorName', 'studentId', 'studentName', 'subject', 'topic', 'bookingType', 'date', 'timeSlot', 'status', 'amountNaira', 'isParentApproved']) &&
             data.keys().hasOnly(['id', 'tutorId', 'tutorName', 'tutorPhoto', 'studentId', 'studentName', 'subject', 'topic', 'bookingType', 'date', 'timeSlot', 'status', 'amountNaira', 'isParentApproved', 'parentApprovalDate', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.tutorId is string && data.tutorId.size() <= 128 &&
             data.tutorName is string && data.tutorName.size() <= 100 &&
             (!('tutorPhoto' in data) || (data.tutorPhoto is string && data.tutorPhoto.size() <= 500)) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() <= 100 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.topic is string && data.topic.size() <= 200 &&
             data.bookingType in ['online', 'physical'] &&
             data.date is string && data.date.size() <= 100 &&
             data.timeSlot is string && data.timeSlot.size() <= 100 &&
             data.status in ['pending_parent', 'confirmed', 'completed', 'cancelled'] &&
             data.amountNaira is number && data.amountNaira >= 0 &&
             data.isParentApproved is bool &&
             (!('parentApprovalDate' in data) || (data.parentApprovalDate is string && data.parentApprovalDate.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'sender', 'text', 'timestamp']) &&
             data.keys().hasOnly(['id', 'senderId', 'sender', 'text', 'timestamp']) &&
             data.id is string && isValidId(data.id) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.sender in ['student', 'tutor'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.timestamp is string && data.timestamp.size() <= 100;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.keys().hasOnly(['email', 'role', 'updatedAt']) &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['superadmin', 'curriculum_moderator'];
    }

    function isValidGrowthPartner(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'referralCode', 'commissionRatePercent', 'totalEarningsNaira', 'totalPaidOutNaira', 'activeReferralsCount', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'name', 'email', 'phone', 'referralCode', 'commissionRatePercent', 'totalEarningsNaira', 'totalPaidOutNaira', 'activeReferralsCount', 'bankName', 'accountNumber', 'accountName', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.referralCode is string && data.referralCode.size() <= 30 &&
             data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 100 &&
             data.totalEarningsNaira is number && data.totalEarningsNaira >= 0 &&
             data.totalPaidOutNaira is number && data.totalPaidOutNaira >= 0 &&
             data.activeReferralsCount is number && data.activeReferralsCount >= 0 &&
             data.status in ['active', 'suspended', 'pending_approval'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 100)) &&
             (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() <= 30)) &&
             (!('accountName' in data) || (data.accountName is string && data.accountName.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['id', 'partnerId', 'referredUserId', 'referralCodeUsed', 'status', 'totalVolumePaidNaira', 'totalCommissionEarnedNaira', 'createdAt']) &&
             data.keys().hasOnly(['id', 'partnerId', 'referredUserId', 'referredUserName', 'referralCodeUsed', 'status', 'totalVolumePaidNaira', 'totalCommissionEarnedNaira', 'lastPaymentDate', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.partnerId is string && isValidId(data.partnerId) &&
             data.referredUserId is string && isValidId(data.referredUserId) &&
             data.referralCodeUsed is string && data.referralCodeUsed.size() <= 30 &&
             data.status in ['active', 'churned'] &&
             data.totalVolumePaidNaira is number && data.totalVolumePaidNaira >= 0 &&
             data.totalCommissionEarnedNaira is number && data.totalCommissionEarnedNaira >= 0 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('referredUserName' in data) || (data.referredUserName is string && data.referredUserName.size() <= 100)) &&
             (!('lastPaymentDate' in data) || (data.lastPaymentDate is string && data.lastPaymentDate.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidPartnerWallet(data) {
      return data.keys().hasAll(['partnerId', 'balanceNaira', 'lifetimeEarnedNaira', 'totalWithdrawnNaira']) &&
             data.keys().hasOnly(['partnerId', 'balanceNaira', 'lifetimeEarnedNaira', 'totalWithdrawnNaira', 'updatedAt']) &&
             data.partnerId is string && isValidId(data.partnerId) &&
             data.balanceNaira is number && data.balanceNaira >= 0 &&
             data.lifetimeEarnedNaira is number && data.lifetimeEarnedNaira >= 0 &&
             data.totalWithdrawnNaira is number && data.totalWithdrawnNaira >= 0 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidRevenueShareTx(data) {
      return data.keys().hasAll(['id', 'partnerId', 'studentId', 'studentName', 'paymentId', 'subscriptionPlan', 'paymentAmountNaira', 'commissionRatePercent', 'commissionAmountNaira', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'partnerId', 'studentId', 'studentName', 'paymentId', 'subscriptionPlan', 'paymentAmountNaira', 'commissionRatePercent', 'commissionAmountNaira', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.partnerId is string && isValidId(data.partnerId) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.paymentAmountNaira is number && data.paymentAmountNaira >= 0 &&
             data.commissionAmountNaira is number && data.commissionAmountNaira >= 0 &&
             data.status in ['credited', 'reversed'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidSubscriptionPayment(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'plan', 'amountNaira', 'paymentGateway', 'status', 'partnerCommissionCredited', 'createdAt']) &&
             data.keys().hasOnly(['id', 'studentId', 'studentName', 'plan', 'amountNaira', 'paymentGateway', 'status', 'partnerId', 'partnerCommissionCredited', 'commissionAmountNaira', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.amountNaira is number && data.amountNaira >= 0 &&
             data.paymentGateway in ['Paystack', 'Flutterwave', 'Direct Escrow'] &&
             data.status in ['successful', 'pending', 'failed'] &&
             data.partnerCommissionCredited is bool &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('partnerId' in data) || (data.partnerId == null || (data.partnerId is string && isValidId(data.partnerId)))) &&
             (!('commissionAmountNaira' in data) || (data.commissionAmountNaira is number && data.commissionAmountNaira >= 0)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidForumChannel(data) {
      return data.keys().hasAll(['id', 'title', 'audience', 'category']) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 100 &&
             data.audience in ['student', 'parent'] &&
             data.category in ['academics', 'competitions', 'general', 'parenting', 'exams'];
    }

    function isValidForumMessage(data) {
      return data.keys().hasAll(['id', 'channelId', 'senderId', 'senderName', 'senderRole', 'text']) &&
             data.id is string && isValidId(data.id) &&
             data.channelId is string && isValidId(data.channelId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.senderRole in ['student', 'parent', 'tutor', 'admin'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000;
    }

    function isValidForumReport(data) {
      return data.keys().hasAll(['id', 'messageId', 'channelId', 'reportedUserId', 'reporterUserId', 'messageText', 'reason', 'status']) &&
             data.id is string && isValidId(data.id) &&
             data.messageId is string && isValidId(data.messageId) &&
             data.reportedUserId is string && isValidId(data.reportedUserId) &&
             data.reporterUserId is string && isValidId(data.reporterUserId) &&
             data.reason in ['spam', 'bullying', 'inappropriate', 'contact_sharing', 'other'] &&
             data.status in ['pending', 'resolved', 'dismissed'];
    }

    function isValidPastQuestion(data) {
      return data.keys().hasAll(['id', 'examType', 'subject', 'year', 'question', 'options', 'correctAnswer', 'explanation', 'topic']) &&
             data.keys().hasOnly(['id', 'examType', 'subject', 'year', 'question', 'options', 'correctAnswer', 'explanation', 'topic', 'passage', 'paperId', 'diagramUrl', 'uploadedBy', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.examType in ['JAMB', 'WAEC', 'NECO'] &&
             data.subject is string && data.subject.size() <= 100 &&
             data.year is number && data.year >= 2000 && data.year <= 2030 &&
             data.question is string && data.question.size() >= 1 && data.question.size() <= 5000 &&
             data.options is list && data.options.size() == 4 &&
             data.correctAnswer is number && data.correctAnswer >= 0 && data.correctAnswer <= 3 &&
             data.explanation is string && data.explanation.size() <= 3000 &&
             data.topic is string && data.topic.size() <= 150 &&
             (!('passage' in data) || data.passage == null || (data.passage is string && data.passage.size() <= 5000)) &&
             (!('paperId' in data) || (data.paperId is string && data.paperId.size() <= 128)) &&
             (!('diagramUrl' in data) || data.diagramUrl == null || (data.diagramUrl is string && data.diagramUrl.size() <= 500)) &&
             (!('uploadedBy' in data) || (data.uploadedBy is string && data.uploadedBy.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    function isValidPastQuestionPaper(data) {
      return data.keys().hasAll(['id', 'examType', 'subject', 'year', 'title', 'totalQuestions']) &&
             data.keys().hasOnly(['id', 'examType', 'subject', 'year', 'title', 'totalQuestions', 'durationMinutes', 'uploadedBy', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.examType in ['JAMB', 'WAEC', 'NECO'] &&
             data.subject is string && data.subject.size() <= 100 &&
             data.year is number && data.year >= 2000 && data.year <= 2030 &&
             data.title is string && data.title.size() <= 200 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             (!('durationMinutes' in data) || data.durationMinutes is number) &&
             (!('uploadedBy' in data) || (data.uploadedBy is string && data.uploadedBy.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidAdminLessonNote(data) {
      return data.keys().hasAll(['id', 'classLevel', 'stream', 'subject', 'term', 'weekNumber', 'topicTitle', 'subtopics', 'readingTimeMinutes', 'summary', 'contentMarkdown', 'keyTakeaways', 'associatedQuizId', 'uploadMode', 'uploadedBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'classLevel', 'stream', 'subject', 'term', 'weekNumber', 'topicTitle', 'subtopics', 'readingTimeMinutes', 'summary', 'contentMarkdown', 'keyTakeaways', 'associatedQuizId', 'uploadMode', 'attachmentName', 'attachmentDataUrl', 'uploadedBy', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.classLevel in ['JSS 1', 'JSS 2', 'JSS 3', 'SS 1', 'SS 2', 'SS 3'] &&
             data.stream in ['Junior', 'Science', 'Non-Science', 'All'] &&
             data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 100 &&
             data.term in ['1st Term', '2nd Term', '3rd Term'] &&
             data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 13 &&
             data.topicTitle is string && data.topicTitle.size() >= 2 && data.topicTitle.size() <= 200 &&
             data.subtopics is list && data.subtopics.size() <= 20 && (data.subtopics.size() == 0 || data.subtopics[0] is string) &&
             data.readingTimeMinutes is number && data.readingTimeMinutes >= 1 && data.readingTimeMinutes <= 180 &&
             data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 1000 &&
             data.contentMarkdown is string && data.contentMarkdown.size() >= 2 && data.contentMarkdown.size() <= 120000 &&
             data.keyTakeaways is list && data.keyTakeaways.size() <= 15 && (data.keyTakeaways.size() == 0 || data.keyTakeaways[0] is string) &&
             data.associatedQuizId is string && data.associatedQuizId.size() <= 128 &&
             data.uploadMode in ['markdown', 'structured'] &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
             (!('attachmentDataUrl' in data) || (data.attachmentDataUrl is string && data.attachmentDataUrl.size() <= 650000)) &&
             data.uploadedBy is string && data.uploadedBy.size() <= 150 &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    function isValidOtaFeatureFlags(flags) {
      return flags is map &&
             flags.keys().hasAll([
               'lessonNotes', 'termlyDrill', 'cbtExams', 'examPrep', 'scienceFormulas', 'uniformVerification',
               'aiCoach', 'gamesHub', 'tutorMarketplace', 'virtualClassroom', 'competitions', 'aspirantHub', 'communityForum',
               'parentPortal', 'tutorPortal', 'schoolAdminPortal', 'growthPartnerPortal'
             ]) &&
             flags.keys().hasOnly([
               'lessonNotes', 'termlyDrill', 'cbtExams', 'examPrep', 'scienceFormulas', 'uniformVerification',
               'aiCoach', 'gamesHub', 'tutorMarketplace', 'virtualClassroom', 'competitions', 'aspirantHub', 'communityForum',
               'parentPortal', 'tutorPortal', 'schoolAdminPortal', 'growthPartnerPortal'
             ]) &&
             flags.lessonNotes is bool &&
             flags.termlyDrill is bool &&
             flags.cbtExams is bool &&
             flags.examPrep is bool &&
             flags.scienceFormulas is bool &&
             flags.uniformVerification is bool &&
             flags.aiCoach is bool &&
             flags.gamesHub is bool &&
             flags.tutorMarketplace is bool &&
             flags.virtualClassroom is bool &&
             flags.competitions is bool &&
             flags.aspirantHub is bool &&
             flags.communityForum is bool &&
             flags.parentPortal is bool &&
             flags.tutorPortal is bool &&
             flags.schoolAdminPortal is bool &&
             flags.growthPartnerPortal is bool;
    }

    function isValidPausedFeatureNotes(notes) {
      return notes is map &&
             notes.size() <= 17 &&
             notes.keys().hasOnly([
               'lessonNotes', 'termlyDrill', 'cbtExams', 'examPrep', 'scienceFormulas', 'uniformVerification',
               'aiCoach', 'gamesHub', 'tutorMarketplace', 'virtualClassroom', 'competitions', 'aspirantHub', 'communityForum',
               'parentPortal', 'tutorPortal', 'schoolAdminPortal', 'growthPartnerPortal'
             ]) &&
             (!('lessonNotes' in notes) || (notes.lessonNotes is string && notes.lessonNotes.size() <= 240)) &&
             (!('termlyDrill' in notes) || (notes.termlyDrill is string && notes.termlyDrill.size() <= 240)) &&
             (!('cbtExams' in notes) || (notes.cbtExams is string && notes.cbtExams.size() <= 240)) &&
             (!('examPrep' in notes) || (notes.examPrep is string && notes.examPrep.size() <= 240)) &&
             (!('scienceFormulas' in notes) || (notes.scienceFormulas is string && notes.scienceFormulas.size() <= 240)) &&
             (!('uniformVerification' in notes) || (notes.uniformVerification is string && notes.uniformVerification.size() <= 240)) &&
             (!('aiCoach' in notes) || (notes.aiCoach is string && notes.aiCoach.size() <= 240)) &&
             (!('gamesHub' in notes) || (notes.gamesHub is string && notes.gamesHub.size() <= 240)) &&
             (!('tutorMarketplace' in notes) || (notes.tutorMarketplace is string && notes.tutorMarketplace.size() <= 240)) &&
             (!('virtualClassroom' in notes) || (notes.virtualClassroom is string && notes.virtualClassroom.size() <= 240)) &&
             (!('competitions' in notes) || (notes.competitions is string && notes.competitions.size() <= 240)) &&
             (!('aspirantHub' in notes) || (notes.aspirantHub is string && notes.aspirantHub.size() <= 240)) &&
             (!('communityForum' in notes) || (notes.communityForum is string && notes.communityForum.size() <= 240)) &&
             (!('parentPortal' in notes) || (notes.parentPortal is string && notes.parentPortal.size() <= 240)) &&
             (!('tutorPortal' in notes) || (notes.tutorPortal is string && notes.tutorPortal.size() <= 240)) &&
             (!('schoolAdminPortal' in notes) || (notes.schoolAdminPortal is string && notes.schoolAdminPortal.size() <= 240)) &&
             (!('growthPartnerPortal' in notes) || (notes.growthPartnerPortal is string && notes.growthPartnerPortal.size() <= 240));
    }

    function isValidOtaAppRelease(data) {
      return data.keys().hasAll(['id', 'latestVersion', 'minimumSupportedVersion', 'upgradeMode', 'releaseTitle', 'releaseNotes', 'featureHighlights', 'featureFlags', 'defaultPausedMessage', 'pausedFeatureNotes', 'maintenanceMode', 'maintenanceMessage', 'publishedAt', 'publishedBy']) &&
             data.keys().hasOnly(['id', 'latestVersion', 'minimumSupportedVersion', 'upgradeMode', 'releaseTitle', 'releaseNotes', 'featureHighlights', 'downloadUrl', 'featureFlags', 'defaultPausedMessage', 'pausedFeatureNotes', 'maintenanceMode', 'maintenanceMessage', 'publishedAt', 'publishedBy']) &&
             data.id is string && isValidId(data.id) &&
             data.latestVersion is string && data.latestVersion.size() >= 5 && data.latestVersion.size() <= 32 && data.latestVersion.matches('^v?[0-9]+\\.[0-9]+\\.[0-9]+$') &&
             data.minimumSupportedVersion is string && data.minimumSupportedVersion.size() >= 5 && data.minimumSupportedVersion.size() <= 32 && data.minimumSupportedVersion.matches('^v?[0-9]+\\.[0-9]+\\.[0-9]+$') &&
             data.upgradeMode in ['mild', 'recommended', 'mandatory'] &&
             data.releaseTitle is string && data.releaseTitle.size() >= 1 && data.releaseTitle.size() <= 160 &&
             data.releaseNotes is string && data.releaseNotes.size() <= 2000 &&
             data.featureHighlights is list && data.featureHighlights.size() <= 10 &&
             (data.featureHighlights.size() == 0 || data.featureHighlights[0] is string) &&
             (!('downloadUrl' in data) || (data.downloadUrl is string && data.downloadUrl.size() <= 500)) &&
             isValidOtaFeatureFlags(data.featureFlags) &&
             data.defaultPausedMessage is string && data.defaultPausedMessage.size() <= 300 &&
             isValidPausedFeatureNotes(data.pausedFeatureNotes) &&
             data.maintenanceMode is bool &&
             data.maintenanceMessage is string && data.maintenanceMessage.size() <= 500 &&
             data.publishedAt is string && data.publishedAt.size() <= 100 &&
             data.publishedBy is string && data.publishedBy.size() <= 150;
    }

    function isValidOtaNotificationBroadcast(data) {
      return data.keys().hasAll(['id', 'title', 'body', 'category', 'targetRoles', 'deepLinkTab', 'actionLabel', 'priority', 'isActive', 'createdAt', 'createdBy']) &&
             data.keys().hasOnly(['id', 'title', 'body', 'category', 'targetRoles', 'deepLinkTab', 'actionLabel', 'priority', 'isActive', 'createdAt', 'createdBy']) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 90 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 280 &&
             data.category in ['streak_risk', 'inactivity_nudge', 'ota_engagement'] &&
             data.targetRoles is list && data.targetRoles.size() >= 1 && data.targetRoles.size() <= 6 &&
             data.deepLinkTab is string && data.deepLinkTab.size() >= 1 && data.deepLinkTab.size() <= 64 &&
             data.actionLabel is string && data.actionLabel.size() >= 1 && data.actionLabel.size() <= 40 &&
             data.priority in ['standard', 'high'] &&
             data.isActive is bool &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.createdBy is string && data.createdBy.size() <= 150;
    }

    // --- COLLECTION RULES ---

    // 1. Students Collection
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (isOwner(studentId) || isAdmin());
      allow list: if isAdmin();
      allow create: if (isOwner(studentId) || isAdmin()) && isValidId(studentId) && incoming().id == studentId && isValidStudentProfile(incoming());
      allow update: if isValidId(studentId) && (
        isAdmin() ||
        (isOwner(studentId) && isValidStudentProfile(incoming()) && incoming().id == existing().id)
      );
      allow delete: if isAdmin();

      // Subcollection: Exam Results
      match /examResults/{resultId} {
        allow get: if isValidId(resultId) && (isOwner(studentId) || isAdmin());
        allow list: if isOwner(studentId) || isAdmin();
        allow create: if isOwner(studentId) && isValidId(resultId) && incoming().id == resultId && incoming().studentId == studentId && isValidExamResult(incoming()) && exists(/databases/$(database)/documents/students/$(studentId));
        allow update, delete: if isAdmin();
      }
    }

    // 2. Parent Wallets Collection
    match /wallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && incoming().userId == userId && isValidParentWallet(incoming());
      allow update: if isValidId(userId) && isValidParentWallet(incoming()) && incoming().userId == existing().userId && (
        isAdmin() ||
        (isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['balanceNaira', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'updatedAt'])
        ))
      );
      allow delete: if isAdmin();
    }

    // 3. Tutor Bookings Collection
    match /tutorBookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isAdmin() ||
        (isVerified() && (resource.data.studentId == request.auth.uid || resource.data.tutorId == request.auth.uid))
      );
      allow list: if isVerified() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerified() && isValidId(bookingId) && incoming().id == bookingId && incoming().studentId == request.auth.uid && isValidTutorBooking(incoming());
      allow update: if isValidId(bookingId) && isValidTutorBooking(incoming()) && incoming().id == existing().id && incoming().studentId == existing().studentId && (
        isAdmin() ||
        (isVerified() && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isParentApproved', 'parentApprovalDate']) ||
          (existing().status != 'completed' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
        ))
      );
      allow delete: if isAdmin();
    }

    // 4. Tutoring Chats Collection
    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isVerified() && isValidId(chatId);
      allow create: if isVerified() && isValidId(chatId) && isValidId(messageId) && incoming().id == messageId && incoming().senderId == request.auth.uid && isValidChatMessage(incoming());
      allow update, delete: if isAdmin();
    }

    // 5. Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerified() && (request.auth.uid == adminId || isAdmin());
      allow create, update: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId && request.auth.token.email == 'martorefe@gmail.com'));
      allow list, delete: if isAdmin();
    }

    // 6. Growth Partners Collection
    match /growthPartners/{partnerId} {
      allow get, list: if true;
      allow create: if isValidId(partnerId) && incoming().id == partnerId && isValidGrowthPartner(incoming());
      allow update: if isValidId(partnerId) && isValidGrowthPartner(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // 7. Referrals Collection
    match /referrals/{referralId} {
      allow get, list: if true;
      allow create: if isValidId(referralId) && isValidReferral(incoming());
      allow update: if isValidId(referralId) && isValidReferral(incoming());
      allow delete: if isAdmin();
    }

    // 8. Partner Wallets Collection
    match /partnerWallets/{partnerId} {
      allow get, list: if true;
      allow create: if isValidId(partnerId) && incoming().partnerId == partnerId && isValidPartnerWallet(incoming());
      allow update: if isValidId(partnerId) && isValidPartnerWallet(incoming()) && incoming().partnerId == existing().partnerId;
      allow delete: if isAdmin();
    }

    // 9. Revenue Share Transactions Collection
    match /revenueShareTransactions/{transactionId} {
      allow get, list: if true;
      allow create: if isValidId(transactionId) && isValidRevenueShareTx(incoming());
      allow update, delete: if isAdmin();
    }

    // 10. Subscription Payments Collection
    match /subscriptionPayments/{paymentId} {
      allow get, list: if true;
      allow create: if isValidId(paymentId) && isValidSubscriptionPayment(incoming());
      allow update, delete: if isAdmin();
    }

    // 11. Forum Channels Collection
    match /forumChannels/{channelId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 12. Forum Messages Collection
    match /forumMessages/{messageId} {
      allow get, list: if true;
      allow create: if isVerified() && isValidId(messageId) && incoming().id == messageId && incoming().senderId == request.auth.uid && isValidForumMessage(incoming());
      allow update: if isVerified() && isValidId(messageId) && (isAdmin() || (incoming().id == existing().id && incoming().senderId == existing().senderId));
      allow delete: if isAdmin();
    }

    // 13. Forum Reports Collection
    match /forumReports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isVerified() && isValidId(reportId) && incoming().id == reportId && incoming().reporterUserId == request.auth.uid && isValidForumReport(incoming());
      allow update, delete: if isAdmin();
    }

    // 14. Connection Test Collection
    match /test/{docId} {
      allow read: if true;
    }

    // 15. Past Questions Collection (CBT Candidates read/stream; Admin/Educators manage)
    match /pastQuestions/{questionId} {
      allow get, list: if true;
      allow create, update: if isValidId(questionId) && isValidPastQuestion(incoming());
      allow delete: if isAdmin();
    }

    // 16. Past Question Papers Collection
    match /pastQuestionPapers/{paperId} {
      allow get, list: if true;
      allow create, update: if isValidId(paperId) && isValidPastQuestionPaper(incoming());
      allow delete: if isAdmin();
    }

    // 17. OTA Ticker Broadcasts (Public read; Admin publish & edit)
    match /otaBroadcasts/{broadcastId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 18. OTA Pop-Up Image Announcements (Public read; Admin publish & edit)
    match /otaAnnouncements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 19. OTA Student Competition Arena Configurations (Public read; Admin manage)
    match /otaCompetitions/{competitionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 20. Termly Drills Collection (CBT candidates read; server / authenticated users save & update)
    match /termly_drills/{drillId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 21. Certificate Drills Collection (BECE, WAEC, NECO, JAMB)
    match /certificate_drills/{drillId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 22. Super Admin Uploaded Curriculum Lesson Notes (Public read; Admin only create/update/delete)
    match /admin_lesson_notes/{noteId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(noteId) && incoming().id == noteId && isValidAdminLessonNote(incoming());
      allow update: if isAdmin() && isValidId(noteId) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && isValidAdminLessonNote(incoming());
      allow delete: if isAdmin() && isValidId(noteId);
    }

    // 23. OTA App Releases & Version Upgrades (Public read; Super Admin only write)
    match /otaAppReleases/{releaseId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(releaseId) && incoming().id == releaseId && isValidOtaAppRelease(incoming());
      allow update: if isAdmin() && isValidId(releaseId) && incoming().id == existing().id && isValidOtaAppRelease(incoming());
      allow delete: if isAdmin() && isValidId(releaseId);
    }

    // 24. OTA Notification & Draw-Back Reminder Broadcasts (Public read; Super Admin only write)
    match /otaNotifications/{notificationId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(notificationId) && incoming().id == notificationId && isValidOtaNotificationBroadcast(incoming());
      allow update: if isAdmin() && isValidId(notificationId) && incoming().id == existing().id && isValidOtaNotificationBroadcast(incoming());
      allow delete: if isAdmin() && isValidId(notificationId);
    }
  }
}
