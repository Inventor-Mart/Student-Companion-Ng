# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE MAPS PLATFORM
# Auto-provisioned demo key or user-provided key for interactive tutor mapping
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."

# GMAIL SMTP EMAIL SERVICE (Enables sending directly to ANY student/parent email address)
# GMAIL_USER: Your Gmail address (e.g. martorefe@gmail.com)
# GMAIL_APP_PASSWORD: A 16-character Google Account App Password
# Generate from: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER="martorefe@gmail.com"
GMAIL_APP_PASSWORD=""

# RESEND EMAIL SERVICE (Alternative provider)
# Your Resend API Key (from https://resend.com/api-keys, begins with "re_")
RESEND_API_KEY=""

# Sender email address
# On Resend free tier or testing with your Gmail: use "Student Companion <onboarding@resend.dev>"
# Once you add and verify a domain in Resend: use e.g. "Student Companion <verify@yourdomain.com>"
RESEND_FROM_EMAIL="Student Companion <onboarding@resend.dev>"

