        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "reporterUserId", "category", "description", "status", "createdAt"]
    },
    "SecurityBlock": {
      "title": "SecurityBlock",
      "description": "Active or historical enforcement block on an IP address, device fingerprint, user account, or wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
