{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Profile data for Nigerian secondary school students",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique student UID corresponding to auth.uid"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Student full name"
        },
        "school": {
          "type": "string",
          "maxLength": 150,
          "description": "Registered secondary school name"
        },
        "classLevel": {
          "type": "string",
          "enum": ["JSS 1", "JSS 2", "JSS 3", "SS 1", "SS 2", "SS 3"],
          "description": "Nigerian curriculum class level"
        },
        "stream": {
          "type": "string",
          "enum": ["Junior", "Science", "Non-Science"],
          "description": "Academic stream"
        },
        "xp": {
          "type": "number",
          "description": "Gamified experience points"
        },
        "rank": {
          "type": "string",
          "enum": ["Fresher", "Scholar", "Prefect", "Senior Boy", "Senior Girl"],
          "description": "Academic rank in school"
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive days of study"
        },
        "lastStudyDate": {
          "type": "string",
          "maxLength": 20,
          "description": "ISO date string of last active study session"
        },
        "uniformVerified": {
          "type": "boolean",
          "description": "Whether school uniform badge is verified"
        },
        "uniformPhotoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "URL of verified school uniform photo"
        },
        "downloadedSubjectIds": {
          "type": "array",
          "description": "List of subject IDs saved for offline access"
        },
        "completedQuizIds": {
          "type": "array",
          "description": "List of completed CBT quiz identifiers"
        }
      },
      "required": ["id", "name", "school", "classLevel", "stream", "xp", "rank", "streakDays"]
    },
    "ExamResult": {
      "title": "ExamResult",
      "description": "CBT mock exam result records for WAEC, JAMB, and NECO",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Result document ID"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Student UID who took the exam"
        },
        "examId": {
          "type": "string",
          "maxLength": 128,
          "description": "Exam identifier"
        },
        "examTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Exam title"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Subject tested"
        },
        "score": {
          "type": "number",
          "description": "Score achieved"
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total exam questions"
        },
        "percentage": {
          "type": "number",
          "description": "Calculated score percentage"
        },
        "timeSpentSeconds": {
          "type": "number",
          "description": "Time spent in seconds"
        },
        "xpAwarded": {
          "type": "number",
          "description": "XP rewarded to student"
        },
        "date": {
          "type": "string",
          "maxLength": 50,
          "description": "Exam submission date timestamp"
        }
      },
      "required": ["id", "studentId", "examId", "examTitle", "subject", "score", "totalQuestions", "percentage", "xpAwarded"]
    },
    "ParentWallet": {
      "title": "ParentWallet",
      "description": "Escrow and funding wallet for parent accounts",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Parent auth UID"
        },
        "balanceNaira": {
          "type": "number",
          "description": "Current wallet balance in Nigerian Naira"
        },
        "pin": {
          "type": "string",
          "maxLength": 10,
          "description": "Encrypted or hashed security PIN"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Last updated date"
        }
      },
      "required": ["userId", "balanceNaira"]
    },
    "TutorBooking": {
      "title": "TutorBooking",
      "description": "Vetted tutor booking session with parent approval escrow",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique booking identifier"
        },
        "tutorId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of vetted tutor"
        },
        "tutorName": {
          "type": "string",
          "maxLength": 100,
          "description": "Tutor full name"
        },
        "tutorPhoto": {
          "type": "string",
          "maxLength": 500,
          "description": "Tutor avatar image URL"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Booking student UID"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Student full name"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Academic subject"
        },
        "topic": {
          "type": "string",
          "maxLength": 200,
          "description": "Target topic for the session"
        },
        "bookingType": {
          "type": "string",
          "enum": ["online", "physical"],
          "description": "Session mode"
        },
        "date": {
          "type": "string",
          "maxLength": 100,
          "description": "Session date"
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 100,
          "description": "Session time slot"
        },
        "status": {
          "type": "string",
          "enum": ["pending_parent", "confirmed", "completed", "cancelled"],
          "description": "Lifecycle state of the booking"
        },
        "amountNaira": {
          "type": "number",
          "description": "Session fee in Naira"
        },
        "isParentApproved": {
          "type": "boolean",
          "description": "Whether parent approved escrow payment"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 100,
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "tutorId", "tutorName", "studentId", "studentName", "subject", "topic", "bookingType", "date", "timeSlot", "status", "amountNaira", "isParentApproved"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time communication message between student and verified tutor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Message identifier"
        },
        "senderId": {
          "type": "string",
          "maxLength": 128,
          "description": "Auth UID of the message author"
        },
        "sender": {
          "type": "string",
          "enum": ["student", "tutor"],
          "description": "Author role"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Sanitized text content of the message"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 100,
          "description": "ISO timestamp or display time"
        }
      },
      "required": ["id", "senderId", "sender", "text", "timestamp"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrative authority and curriculum verification roles",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Verified administrator email"
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "curriculum_moderator"],
          "description": "Admin privilege level"
        }
      },
      "required": ["email", "role"]
    },
    "GrowthPartner": {
      "title": "GrowthPartner",
      "description": "Registered Growth Partner profile for lifetime revenue sharing",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Partner UID corresponding to auth.uid"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Partner full name or corporate organization"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Partner contact email"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Partner telephone number"
        },
        "referralCode": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique referral code for attributing students"
        },
        "commissionRatePercent": {
          "type": "number",
          "description": "Revenue share percentage (default 10%)"
        },
        "totalEarningsNaira": {
          "type": "number",
          "description": "Cumulative gross commissions earned in Naira"
        },
        "totalPaidOutNaira": {
          "type": "number",
          "description": "Total amount paid out to bank in Naira"
        },
        "activeReferralsCount": {
          "type": "number",
          "description": "Total number of active attributed students"
        },
        "bankName": {
          "type": "string",
          "maxLength": 100,
          "description": "Settlement commercial bank in Nigeria"
        },
        "accountNumber": {
          "type": "string",
          "maxLength": 20,
          "description": "NUBAN 10-digit settlement account number"
        },
        "accountName": {
          "type": "string",
          "maxLength": 100,
          "description": "Verified bank account holder name"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "pending_approval"],
          "description": "Partner account status"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Partner onboarding ISO timestamp"
        }
      },
      "required": ["id", "name", "email", "referralCode", "commissionRatePercent", "totalEarningsNaira", "totalPaidOutNaira", "activeReferralsCount", "status", "createdAt"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Attribution mapping linking a Growth Partner to a referred student/parent",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Referral record ID"
        },
        "partnerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Attributed Growth Partner UID"
        },
        "referredUserId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Student or parent auth UID"
        },
        "referredUserName": {
          "type": "string",
          "maxLength": 100,
          "description": "Student display name"
        },
        "referralCodeUsed": {
          "type": "string",
          "maxLength": 30,
          "description": "The partner referral code entered at sign-up"
        },
        "status": {
          "type": "string",
          "enum": ["active", "churned"],
          "description": "Referral relationship lifecycle state"
        },
        "totalVolumePaidNaira": {
          "type": "number",
          "description": "Lifetime subscription volume paid by the student"
        },
        "totalCommissionEarnedNaira": {
          "type": "number",
          "description": "Total 10% lifetime commission generated for partner"
        },
        "lastPaymentDate": {
          "type": "string",
          "maxLength": 50,
          "description": "Most recent payment timestamp"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Attribution creation timestamp"
        }
      },
      "required": ["id", "partnerId", "referredUserId", "referralCodeUsed", "status", "totalVolumePaidNaira", "totalCommissionEarnedNaira", "createdAt"]
    },
    "PartnerWallet": {
      "title": "PartnerWallet",
      "description": "Digital wallet balance and earnings ledger for Growth Partners",
      "type": "object",
      "properties": {
        "partnerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Partner UID corresponding to auth.uid"
        },
        "balanceNaira": {
          "type": "number",
          "description": "Available withdrawable commission balance in Naira"
        },
        "lifetimeEarnedNaira": {
          "type": "number",
          "description": "Total lifetime commission earned"
        },
        "totalWithdrawnNaira": {
          "type": "number",
          "description": "Total commission successfully withdrawn"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Last balance update timestamp"
        }
      },
      "required": ["partnerId", "balanceNaira", "lifetimeEarnedNaira", "totalWithdrawnNaira", "updatedAt"]
    },
    "RevenueShareTransaction": {
      "title": "RevenueShareTransaction",
      "description": "Immutable ledger receipt of a 10% revenue share payout credited to a partner",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique transaction record identifier"
        },
        "partnerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Credited partner UID"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Subscribing student UID"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Subscribing student name"
        },
        "paymentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Reference ID of the source subscription payment"
        },
        "subscriptionPlan": {
          "type": "string",
          "maxLength": 100,
          "description": "Purchased subscription tier (e.g. WAEC Termly Pass)"
        },
        "paymentAmountNaira": {
          "type": "number",
          "description": "Total subscription fee paid by student"
        },
        "commissionRatePercent": {
          "type": "number",
          "description": "Commission rate applied (10)"
        },
        "commissionAmountNaira": {
          "type": "number",
          "description": "Exact 10% credit amount in Naira"
        },
        "status": {
          "type": "string",
          "enum": ["credited", "reversed"],
          "description": "Credit status"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Transaction timestamp"
        }
      },
      "required": ["id", "partnerId", "studentId", "studentName", "paymentId", "subscriptionPlan", "paymentAmountNaira", "commissionRatePercent", "commissionAmountNaira", "status", "createdAt"]
    },
    "SubscriptionPayment": {
      "title": "SubscriptionPayment",
      "description": "Student subscription payment transaction record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique payment reference identifier"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Subscribing student UID"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Subscribing student full name"
        },
        "plan": {
          "type": "string",
          "maxLength": 100,
          "description": "Subscription tier title"
        },
        "amountNaira": {
          "type": "number",
          "description": "Amount paid in Nigerian Naira"
        },
        "paymentGateway": {
          "type": "string",
          "enum": ["Paystack", "Flutterwave", "Direct Escrow"],
          "description": "Payment processor gateway"
        },
        "status": {
          "type": "string",
          "enum": ["successful", "pending", "failed"],
          "description": "Payment settlement status"
        },
        "partnerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Attributed Growth Partner UID, if referred"
        },
        "partnerCommissionCredited": {
          "type": "boolean",
          "description": "Whether 10% revenue share was credited to partner wallet"
        },
        "commissionAmountNaira": {
          "type": "number",
          "description": "Calculated 10% commission in Naira"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Payment creation timestamp"
        }
      },
      "required": ["id", "studentId", "studentName", "plan", "amountNaira", "paymentGateway", "status", "partnerCommissionCredited", "createdAt"]
    },
    "ForumChannel": {
      "title": "ForumChannel",
      "description": "Topic and group communication channel for students or parents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "audience": { "type": "string", "enum": ["student", "parent"] },
        "category": { "type": "string", "enum": ["academics", "competitions", "general", "parenting", "exams"] },
        "iconName": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "audience", "category"]
    },
    "ForumMessage": {
      "title": "ForumMessage",
      "description": "Individual community forum post or discussion thread reply",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["student", "parent", "tutor", "admin"] },
        "text": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "channelId", "senderId", "senderName", "senderRole", "text"]
    },
    "ForumReport": {
      "title": "ForumReport",
      "description": "User-submitted flag against inappropriate or harmful message content",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "messageId": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "reportedUserId": { "type": "string", "maxLength": 128 },
        "reporterUserId": { "type": "string", "maxLength": 128 },
        "messageText": { "type": "string", "maxLength": 1000 },
        "reason": { "type": "string", "enum": ["spam", "bullying", "inappropriate", "contact_sharing", "other"] },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] }
      },
      "required": ["id", "messageId", "channelId", "reportedUserId", "reporterUserId", "messageText", "reason", "status"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check document for testing Firestore connectivity on boot",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/test/{docId}": {
      "schema": {
        "$ref": "#/entities/TestConnection"
      },
      "description": "Connectivity test probe"
    },
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/StudentProfile"
      },
      "description": "Student profiles and academic records"
    },
    "/students/{studentId}/examResults/{resultId}": {
      "schema": {
        "$ref": "#/entities/ExamResult"
      },
      "description": "Subcollection of CBT exam records owned by student"
    },
    "/wallets/{userId}": {
      "schema": {
        "$ref": "#/entities/ParentWallet"
      },
      "description": "Secure parent wallet documents"
    },
    "/tutorBookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/TutorBooking"
      },
      "description": "Vetted tutor bookings with escrow states"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Subcollection of chat messages within a direct tutoring thread"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Authorized admin accounts and curriculum verifiers"
    },
    "/growthPartners/{partnerId}": {
      "schema": {
        "$ref": "#/entities/GrowthPartner"
      },
      "description": "Growth partner profiles and referral metrics"
    },
    "/referrals/{referralId}": {
      "schema": {
        "$ref": "#/entities/Referral"
      },
      "description": "Referrals linking partners to students"
    },
    "/partnerWallets/{partnerId}": {
      "schema": {
        "$ref": "#/entities/PartnerWallet"
      },
      "description": "Growth Partner digital earnings wallet"
    },
    "/revenueShareTransactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/RevenueShareTransaction"
      },
      "description": "Immutable ledger of 10% revenue share credits"
    },
    "/subscriptionPayments/{paymentId}": {
      "schema": {
        "$ref": "#/entities/SubscriptionPayment"
      },
      "description": "Student subscription payment transaction receipts"
    },
    "/forumChannels/{channelId}": {
      "schema": {
        "$ref": "#/entities/ForumChannel"
      },
      "description": "Community forum topic channels"
    },
    "/forumMessages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ForumMessage"
      },
      "description": "Messages posted in community channels"
    },
    "/forumReports/{reportId}": {
      "schema": {
        "$ref": "#/entities/ForumReport"
      },
      "description": "Safety violation reports submitted for administrative review"
    }
  }
}
