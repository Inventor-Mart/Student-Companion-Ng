        "suspectIdentifier": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "evidenceContext": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "investigating", "resolved", "dismissed"] },
